# Port HTTP du serveur Node
PORT=3000

# Interface d'écoute (0.0.0.0 = accessible réseau / tunnel / VPS)
HOST=0.0.0.0

# development | production
NODE_ENV=development

# 1 = derrière Cloudflare / Nginx / Caddy (recommandé)
# 0 = désactiver si besoin
TRUST_PROXY=1

# Origines CORS autorisées pour Socket.IO
# - vide : accepte l'origine de la requête (recommandé en même domaine)
# - * : tout autoriser
# - liste : https://oie.example.com,https://www.example.com
# CORS_ORIGIN=

# Optionnel — timeouts Socket.IO (ms), utiles derrière un tunnel
# SOCKET_PING_INTERVAL=25000
# SOCKET_PING_TIMEOUT=60000
